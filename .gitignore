# Dependencies
/backend/vendor/
/frontend/node_modules/

# Frontend build output
/frontend/dist/
/frontend/coverage/

# Environment files (never commit secrets/keys)
.env
.env.backup
.env.production
.env.local
.env.*.local
!backend/.env
backend/.env.backup

# Laravel runtime
/backend/storage/*.key
/backend/storage/pail
/backend/bootstrap/cache/*.php
!/backend/bootstrap/cache/.gitignore

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editors / OS
.idea
.vscode
.fleet
.nova
.zed
.DS_Store
Thumbs.db
